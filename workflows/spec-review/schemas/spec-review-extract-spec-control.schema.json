{
  "type": "object",
  "required": [
    "schema",
    "digest",
    "specSources",
    "requirements"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "specSources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "anyOf": [
          { "type": "string", "minLength": 1, "maxLength": 240 },
          {
            "type": "object",
            "required": ["kind", "file"],
            "properties": {
              "kind": { "type": "string", "enum": ["local"] },
              "file": { "type": "string", "minLength": 1, "maxLength": 240 }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement", "specEvidence", "priority", "implementationSignals", "testSignals"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 96 },
          "requirement": { "type": "string", "minLength": 8, "maxLength": 512 },
          "specEvidence": {
            "anyOf": [
              {
                "type": "object",
                "required": ["file", "lineStart", "lineEnd", "quote"],
                "properties": {
                  "file": { "type": "string", "minLength": 1, "maxLength": 240 },
                  "lineStart": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                  "lineEnd": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                  "quote": { "type": "string", "minLength": 1, "maxLength": 240 },
                  "relevance": { "type": "string", "maxLength": 240 }
                },
                "additionalProperties": false
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": ["file", "lineStart", "lineEnd", "quote"],
                  "properties": {
                    "file": { "type": "string", "minLength": 1, "maxLength": 240 },
                    "lineStart": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "lineEnd": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                    "quote": { "type": "string", "minLength": 1, "maxLength": 240 },
                    "relevance": { "type": "string", "maxLength": 240 }
                  },
                  "additionalProperties": false
                }
              }
            ]
          },
          "priority": { "type": "string", "enum": ["high", "medium", "low", "info"] },
          "implementationSignals": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 4 },
          "testSignals": { "type": "array", "items": { "type": "string", "maxLength": 80 }, "maxItems": 4 }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 40
    }
  }
}
