{
  "type": "object",
  "required": [
    "schema",
    "digest",
    "sourceStatusSummary",
    "verifierCoverage",
    "verdictCounts",
    "requirementCoverage",
    "finalFindings",
    "droppedFindings",
    "needsHuman",
    "missingVerifications",
    "invalidVerifierResults",
    "orphanVerifierResults",
    "noIssueNotes",
    "readProjection"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "spec-review-partition-v1"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "evidenceGate": {
      "type": "object",
      "required": ["protocol", "complete", "findings", "coverage", "requirementReconciliation"],
      "properties": {
        "protocol": { "const": "spec-local-evidence-v1", "type": "string" },
        "complete": { "type": "boolean" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "verdict", "complete", "rows"],
            "properties": {
              "id": { "type": "string" },
              "verdict": { "type": "string", "enum": ["KEEP", "WEAKEN", "DROP", "NEEDS_HUMAN"] },
              "complete": { "type": "boolean" },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object", "required": ["field", "index", "citation", "status"],
                  "properties": {
                    "field": { "type": "string", "enum": ["evidence", "counterEvidence"] },
                    "index": { "type": "integer", "minimum": 0 },
                    "status": { "type": "string", "enum": ["verified", "mismatch", "unreadable", "unverified"] },
                    "reason": { "type": "string" },
                    "sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                    "citation": { "anyOf": [
                      { "type": "string" },
                      { "type": "object", "required": ["file", "lineStart", "lineEnd", "quote"], "properties": {
                        "file": { "type": "string", "minLength": 1 },
                        "lineStart": { "type": "integer", "minimum": 1 },
                        "lineEnd": { "type": "integer", "minimum": 1 },
                        "quote": { "type": "string", "minLength": 1 },
                        "relevance": { "type": "string" }
                      }, "additionalProperties": false }
                    ] }
                  }, "additionalProperties": false
                }
              }
            }, "additionalProperties": false
          }
        },
        "requirementReconciliation": {
          "type": "object",
          "required": ["protocol", "proof", "sourceEvidence", "requirementIds", "coverageIds", "missingIds", "unresolvedIds", "issues", "complete", "allCovered"],
          "properties": {
            "protocol": { "const": "spec-requirement-reconciliation-v1", "type": "string" },
            "proof": { "anyOf": [
              { "type": "null" },
              { "type": "object", "required": ["runId", "candidateTaskId", "candidateControlSha256", "candidateManifestSha256", "extractTaskId", "extractControlSha256", "mapTaskId", "mapControlSha256", "inspectTestsTaskId", "inspectTestsControlSha256"], "properties": {
                "runId": { "type": "string", "minLength": 1 },
                "candidateTaskId": { "type": "string", "minLength": 1 },
                "extractTaskId": { "type": "string", "minLength": 1 },
                "mapTaskId": { "type": "string", "minLength": 1 },
                "inspectTestsTaskId": { "type": "string", "minLength": 1 },
                "candidateControlSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "candidateManifestSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "extractControlSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "mapControlSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "inspectTestsControlSha256": { "type": "string", "minLength": 64, "maxLength": 64 }
              }, "additionalProperties": false }
            ] },
            "sourceEvidence": { "type": "array", "maxItems": 40, "items": { "type": "object" } },
            "requirementIds": { "type": "array", "items": { "type": "string", "maxLength": 96 } },
            "coverageIds": { "type": "array", "items": { "type": "string" } },
            "missingIds": { "type": "array", "items": { "type": "string" } },
            "unresolvedIds": { "type": "array", "items": { "type": "string" } },
            "issues": { "type": "array", "items": { "type": "string" } },
            "complete": { "type": "boolean" },
            "allCovered": { "type": "boolean" }
          }, "additionalProperties": false
        },
        "coverage": { "type": "array", "items": {
          "type": "object", "required": ["index", "id", "verdict", "complete", "rows", "positive", "status", "accountedBy"],
          "properties": {
            "index": { "type": "integer", "minimum": 0 },
            "id": { "type": "string" },
            "verdict": { "type": "string", "const": "KEEP" },
            "complete": { "type": "boolean" },
            "positive": { "type": "boolean" },
            "status": { "type": "string" },
            "accountedBy": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "object" } }
          }, "additionalProperties": false
        } }
      }, "additionalProperties": false
    },
    "sourceStatusSummary": {
      "type": "object",
      "required": [
        "metadataAvailable",
        "total",
        "completed",
        "nonCompleted",
        "partialFailures"
      ],
      "properties": {
        "metadataAvailable": { "type": "boolean" },
        "total": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "nonCompleted": { "type": "integer", "minimum": 0 },
        "partialFailures": {
          "type": "array",
          "items": { "type": "object" },
          "maxItems": 64
        },
        "omittedPartialFailures": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "verifierCoverage": {
      "type": "object",
      "required": [
        "complete",
        "candidateCount",
        "uniqueCandidateCount",
        "verifierCount",
        "uniqueVerifierCount",
        "verifiedCandidateCount",
        "missingIds",
        "duplicateCandidateIds",
        "duplicateVerifierIds",
        "orphanVerifierIds",
        "candidateUniverse"
      ],
      "properties": {
        "complete": { "type": "boolean" },
        "candidateCount": { "type": "integer", "minimum": 0 },
        "uniqueCandidateCount": { "type": "integer", "minimum": 0 },
        "verifierCount": { "type": "integer", "minimum": 0 },
        "uniqueVerifierCount": { "type": "integer", "minimum": 0 },
        "verifiedCandidateCount": { "type": "integer", "minimum": 0 },
        "missingIds": { "type": "array", "items": { "type": "string" } },
        "duplicateCandidateIds": { "type": "array", "items": { "type": "string" } },
        "duplicateVerifierIds": { "type": "array", "items": { "type": "string" } },
        "orphanVerifierIds": { "type": "array", "items": { "type": "string", "maxLength": 96 } },
        "candidateUniverse": {
          "type": "object",
          "required": ["schema", "count", "uniqueCount", "ids", "duplicateIds", "invalidRowCount", "proof"],
          "properties": {
            "schema": { "const": "spec-review-runtime-candidate-universe-v1", "type": "string" },
            "count": { "type": "integer", "minimum": 0 },
            "uniqueCount": { "type": "integer", "minimum": 0 },
            "ids": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 96 }, "maxItems": 30 },
            "duplicateIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 96 }, "maxItems": 30 },
            "invalidRowCount": { "type": "integer", "minimum": 0 },
            "proof": { "anyOf": [
              { "type": "null" },
              { "type": "object", "required": ["runId", "candidateTaskId", "candidateControlSha256", "candidateManifestSha256", "extractTaskId", "extractControlSha256", "mapTaskId", "mapControlSha256", "inspectTestsTaskId", "inspectTestsControlSha256"], "properties": {
                "runId": { "type": "string", "minLength": 1 },
                "candidateTaskId": { "type": "string", "minLength": 1 },
                "candidateControlSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "candidateManifestSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "extractTaskId": { "type": "string", "minLength": 1 },
                "extractControlSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "mapTaskId": { "type": "string", "minLength": 1 },
                "mapControlSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
                "inspectTestsTaskId": { "type": "string", "minLength": 1 },
                "inspectTestsControlSha256": { "type": "string", "minLength": 64, "maxLength": 64 }
              }, "additionalProperties": false }
            ] }
          },
          "additionalProperties": false
        },
        "ownerLedger": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "stageId", "specId", "taskId", "itemIdentity", "placeholderSpecId", "status"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "stageId": { "type": "string", "minLength": 1 },
              "specId": { "type": "string", "minLength": 1 },
              "taskId": { "type": "string", "minLength": 1 },
              "batchId": { "type": "string" },
              "itemIdentity": { "type": "string", "minLength": 1 },
              "placeholderSpecId": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "const": "completed" }
            },
            "additionalProperties": false
          },
          "maxItems": 128
        },
        "batchOwnerLedger": {
          "type": "array",
          "items": { "type": "object" },
          "maxItems": 128
        },
        "verifierRows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "owner"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "owner": {
                "type": "object",
                "required": ["source", "stageId", "specId", "taskId", "itemIdentity", "placeholderSpecId", "status"],
                "properties": {
                  "source": { "type": "string", "minLength": 1 },
                  "stageId": { "type": "string", "minLength": 1 },
                  "specId": { "type": "string", "minLength": 1 },
                  "taskId": { "type": "string", "minLength": 1 },
                  "itemIdentity": { "type": "string", "minLength": 1 },
                  "placeholderSpecId": { "type": "string", "minLength": 1 },
                  "status": { "type": "string", "const": "completed" },
                  "batchId": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": true
          },
          "maxItems": 256
        },
        "ownerLedgerReconciliation": {
          "type": "object",
          "required": ["ownerRowCount", "verifierRowCount", "ownerIds", "verifierIds", "duplicateOwnerIds", "duplicateVerifierIds", "missingOwnerRows", "orphanOwnerRows", "statusMismatches", "cardinalityPassed", "passed"],
          "properties": {
            "ownerRowCount": { "type": "integer", "minimum": 0 },
            "verifierRowCount": { "type": "integer", "minimum": 0 },
            "ownerIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "verifierIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "duplicateOwnerIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "duplicateVerifierIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "missingOwnerRows": { "type": "array", "items": { "type": "string" } },
            "orphanOwnerRows": { "type": "array", "items": { "type": "string" } },
            "statusMismatches": { "type": "array", "items": { "type": "string" } },
            "cardinalityPassed": { "type": "boolean" },
            "passed": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "batch": { "type": "object" },
        "candidateUniverseReconciliation": {
          "type": "object",
          "required": ["issues", "passed", "runtimeIds", "sourceIds"],
          "properties": {
            "issues": { "type": "array", "items": { "type": "string" }, "maxItems": 16 },
            "passed": { "type": "boolean" },
            "runtimeIds": { "type": "array", "items": { "type": "string", "maxLength": 96 }, "maxItems": 30 },
            "sourceIds": { "type": "array", "items": { "type": "string", "maxLength": 96 }, "maxItems": 30 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verdictCounts": {
      "type": "object",
      "required": [
        "keep",
        "weaken",
        "drop",
        "needsHuman",
        "missingVerification",
        "invalidVerifier",
        "orphanVerifier"
      ],
      "properties": {
        "keep": { "type": "integer", "minimum": 0 },
        "weaken": { "type": "integer", "minimum": 0 },
        "drop": { "type": "integer", "minimum": 0 },
        "needsHuman": { "type": "integer", "minimum": 0 },
        "missingVerification": { "type": "integer", "minimum": 0 },
        "invalidVerifier": { "type": "integer", "minimum": 0 },
        "orphanVerifier": { "type": "integer", "minimum": 0 },
        "batchIntegrity": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "requirementCoverage": { "type": "array", "items": { "type": "object", "properties": {
      "evidence": { "type": "array", "items": { "anyOf": [
        { "type": "string" },
        { "type": "object", "required": ["file", "lineStart", "lineEnd", "quote"], "properties": {
          "file": { "type": "string", "minLength": 1 }, "lineStart": { "type": "integer", "minimum": 1 },
          "lineEnd": { "type": "integer", "minimum": 1 }, "quote": { "type": "string", "minLength": 1 }, "relevance": { "type": "string" }
        }, "additionalProperties": false }
      ] } }
    } }, "maxItems": 80 },
    "finalFindings": { "type": "array", "items": { "type": "object", "properties": {
      "evidence": { "type": "array", "items": { "anyOf": [
        { "type": "string" },
        { "type": "object", "required": ["file", "lineStart", "lineEnd", "quote"], "properties": {
          "file": { "type": "string", "minLength": 1 }, "lineStart": { "type": "integer", "minimum": 1 },
          "lineEnd": { "type": "integer", "minimum": 1 }, "quote": { "type": "string", "minLength": 1 }, "relevance": { "type": "string" }
        }, "additionalProperties": false }
      ] } }
    } }, "maxItems": 64 },
    "droppedFindings": { "type": "array", "items": { "type": "object", "properties": {
      "counterEvidence": { "type": "array", "items": { "anyOf": [
        { "type": "string" },
        { "type": "object", "required": ["file", "lineStart", "lineEnd", "quote"], "properties": {
          "file": { "type": "string", "minLength": 1 }, "lineStart": { "type": "integer", "minimum": 1 },
          "lineEnd": { "type": "integer", "minimum": 1 }, "quote": { "type": "string", "minLength": 1 }, "relevance": { "type": "string" }
        }, "additionalProperties": false }
      ] } }
    } }, "maxItems": 64 },
    "needsHuman": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["source", "requirementIds", "origin", "reason", "uncertainty", "finalClaim", "recommendedAction", "evidenceStatus"],
        "properties": {
          "source": { "type": "string", "minLength": 1, "maxLength": 96 },
          "id": { "type": "string", "minLength": 1, "maxLength": 96 },
          "title": { "type": "string", "maxLength": 512 },
          "requirementIds": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 96 }, "maxItems": 40 },
          "origin": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
              "candidateId": { "type": "string", "minLength": 1, "maxLength": 96 },
              "sourceId": { "type": "string", "minLength": 1, "maxLength": 160 }
            },
            "additionalProperties": false
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "uncertainty": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "finalClaim": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "recommendedAction": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "evidenceStatus": { "type": "string", "enum": ["unavailable", "unverified_or_incomplete"] },
          "originalCandidate": { "type": "object" },
          "verifierResult": { "type": "object" },
          "details": { "type": "object" },
          "evidenceGate": { "type": "object" },
          "batchIntegrityIssue": { "type": "object" },
          "invalidVerifierResult": { "type": "object" },
          "candidateUniverseIssues": { "type": "array", "items": { "type": "string" } },
          "verdict": { "type": "string" },
          "originalVerdict": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "missingVerifications": { "type": "array", "items": { "type": "object" }, "maxItems": 64 },
    "invalidVerifierResults": { "type": "array", "items": { "type": "object" }, "maxItems": 64 },
    "orphanVerifierResults": { "type": "array", "items": { "type": "object" }, "maxItems": 64 },
    "batchIntegrityIssues": { "type": "array", "items": { "type": "object" }, "maxItems": 128 },
     "noIssueNotes": { "type": "array", "maxItems": 80 },
     "scopeLimitations": {
       "type": "array",
       "maxItems": 40,
       "items": {
         "type": "object",
         "required": ["kind", "text"],
         "properties": {
           "kind": { "type": "string", "const": "NONBLOCKING" },
           "text": { "type": "string", "minLength": 1, "maxLength": 240 },
           "blocking": { "type": "boolean", "const": false }
         },
         "additionalProperties": false
       }
     },
     "testExecutionAttested": { "type": "boolean", "const": false },
     "readProjection": {
       "type": "object",
       "required": ["candidateIds", "requirementIds", "finalIds", "droppedIds", "needsHumanIds"],
       "properties": {
         "candidateIds": { "type": "array", "items": { "type": "string", "maxLength": 96 }, "maxItems": 30 },
         "requirementIds": { "type": "array", "items": { "type": "string", "maxLength": 96 }, "maxItems": 40 },
         "finalIds": { "type": "array", "items": { "type": "string", "maxLength": 96 }, "maxItems": 64 },
         "droppedIds": { "type": "array", "items": { "type": "string", "maxLength": 96 }, "maxItems": 64 },
         "needsHumanIds": { "type": "array", "items": { "type": "string", "maxLength": 96 }, "maxItems": 256 }
       },
       "additionalProperties": false
     }
  },
  "additionalProperties": false
}
