{
  "type": "object",
  "required": ["schema", "digest", "implementationMap"],
  "properties": {
    "schema": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "digest": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "implementationMap": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "properties": {
          "component": { "type": "string", "maxLength": 240 },
          "file": { "type": "string", "maxLength": 240 },
          "evidence": { "type": "string", "maxLength": 400 },
          "observedBehavior": { "type": "string", "maxLength": 400 },
          "relatedSignals": { "type": "array", "maxItems": 8, "items": { "type": "string", "maxLength": 80 } }
        },
        "additionalProperties": false
      }
    },
    "unmappedAreas": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 240 } },
    "notes": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 240 } }
  },
  "additionalProperties": false
}
