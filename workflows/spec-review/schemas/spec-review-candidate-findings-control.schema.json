{
  "type": "object",
  "required": [
    "schema",
    "digest",
    "candidateFindings",
    "requirementCoverage"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "candidateFindings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 30
    },
    "requirementCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirementId", "status"],
        "properties": {
          "requirementId": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["covered", "gap", "partial", "unclear", "needsHuman"] },
          "evidence": { "type": "array", "maxItems": 64, "items": { "anyOf": [
            { "type": "string" },
            { "type": "object", "required": ["file", "lineStart", "lineEnd", "quote"], "properties": {
              "file": { "type": "string", "minLength": 1 },
              "lineStart": { "type": "integer", "minimum": 1 },
              "lineEnd": { "type": "integer", "minimum": 1 },
              "quote": { "type": "string", "minLength": 1 },
              "relevance": { "type": "string" }
            }, "additionalProperties": false }
          ] } }
        }
      },
      "maxItems": 40
    }
  }
}
