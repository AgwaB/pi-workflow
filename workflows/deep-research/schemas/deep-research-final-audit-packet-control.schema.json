{
  "type": "object",
  "required": ["schema", "digest", "packet"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "deep-research-final-audit-packet-v1"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "packet": {
      "type": "object",
      "required": [
        "synthesisInput",
        "researchMetadataSeed",
        "verdictCounts",
        "statusPartitions",
        "factSlotCoverage",
        "factSlotStatusCounts",
        "coverageGaps",
        "remainingGaps",
        "sourceRefJoinFailures",
        "claimVerdictLedger",
        "verifierIntegrity",
        "normalizerDiagnostics",
        "preservedClaims",
        "researchScopeCoverage",
        "invariantChecks",
        "overflowLedger"
      ],
      "properties": {
        "synthesisInput": {
          "type": "object",
          "required": [
            "header",
            "pages"
          ],
          "properties": {
            "header": {
              "type": "object",
              "required": [
                "schema",
                "pageCount",
                "maxChars",
                "fields",
                "pageEntryCounts"
              ],
              "properties": {
                "schema": {
                  "const": "deep-research-synthesis-pages-v1"
                },
                "pageCount": {
                  "const": 8
                },
                "maxChars": {
                  "const": 24000
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "field",
                      "kind",
                      "count"
                    ],
                    "properties": {
                      "field": {
                        "type": "string"
                      },
                      "kind": {
                        "enum": [
                          "array",
                          "value"
                        ]
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "pageEntryCounts": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 8,
                  "maxItems": 8
                },
                "budgetBlock": {
                  "type": "object",
                  "required": [
                    "status",
                    "reason",
                    "canonicalLedgerPreserved"
                  ],
                  "properties": {
                    "status": {
                      "const": "blocked"
                    },
                    "reason": {
                      "enum": [
                        "oversized_row",
                        "page_bank_exhausted",
                        "oversized_header"
                      ]
                    },
                    "canonicalLedgerPreserved": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "index",
                  "entries"
                ],
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 7
                  },
                  "entries": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "field",
                        "value"
                      ],
                      "properties": {
                        "field": {
                          "type": "string"
                        },
                        "index": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "value": {}
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "minItems": 8,
              "maxItems": 8
            }
          },
          "additionalProperties": false
        },
        "researchMetadataSeed": { "type": "object" },
        "verdictCounts": { "type": "object" },
        "statusPartitions": { "type": "object" },
        "factSlotCoverage": { "type": "array", "items": { "type": "object" } },
        "factSlotReconciliation": {
          "type": "object",
          "description": "Reverse candidate bindings may be appended only from valid canonical claim factSlotIds; unknown or contradictory hints remain visible for deterministic rejection.",
          "properties": {
            "source": { "type": "string" },
            "addedReverseBindings": { "type": "array", "items": { "type": "object" } },
            "preservedReverseBindings": { "type": "array", "items": { "type": "object" } },
            "invalidCanonicalMemberships": { "type": "array", "items": { "type": "object" } }
          }
        },
        "factSlotStatusCounts": { "type": "object" },
        "coverageGaps": { "type": "array", "items": { "type": "object" } },
        "remainingGaps": { "type": "array", "items": { "type": "object" } },
        "sourceRefJoinFailures": { "type": "array", "items": { "type": "object" } },
        "claimVerdictLedger": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "The canonical ledger preserves bounded verifier evidence, including local file/range/quote locations; local evidence does not require an HTTP URL.",
            "properties": {
              "evidence": { "type": "array", "items": { "type": "object" }, "maxItems": 5 },
              "localQuoteGate": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "verifierIntegrity": {
          "type": "object",
          "properties": {
            "gateSummary": { "type": "object" },
            "invalidVerifierRows": { "type": "array", "items": { "type": "object" } },
            "duplicateVerifierRows": { "type": "array", "items": { "type": "object" } },
            "verifierOwnerLedger": { "type": "array", "items": { "type": "object" } },
            "verifierOwnerIssues": { "type": "array", "items": { "type": "object" } },
            "invalidNormalizedCandidateCount": { "type": "integer", "minimum": 0 },
            "invalidNormalizedCandidateRows": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": true
        },
        "normalizerDiagnostics": { "type": "object" },
        "preservedClaims": { "type": "array", "items": { "type": "object" } },
        "researchScopeCoverage": { "type": "array", "items": { "type": "object" } },
        "invariantChecks": { "type": "object" },
        "overflowLedger": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
