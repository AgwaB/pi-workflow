{
  "type": "object",
  "required": ["schema", "digest", "results"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "findingId",
          "title",
          "verdict",
          "evidence",
          "counterEvidence",
          "recommendedAction"
        ],
        "additionalProperties": false,
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "string",
            "enum": ["KEEP", "WEAKEN", "DROP", "NEEDS_HUMAN"]
          },
          "evidence": {
            "type": "array",
            "items": {}
          },
          "counterEvidence": {
            "type": "array",
            "items": {}
          },
          "recommendedAction": {
            "type": "string"
          }
        }
      }
    }
  }
}
