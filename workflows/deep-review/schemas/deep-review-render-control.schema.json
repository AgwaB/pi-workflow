{
  "type": "object",
  "required": [
    "schema",
    "digest",
    "status",
    "completionSummaryMarkdown",
    "markdown",
    "findingSummary",
    "renderedFindingIds",
    "renderedNeedsHumanIds",
    "sourceArtifacts",
    "gates"
  ],
  "properties": {
    "schema": { "type": "string", "const": "deep-review-render-v1" },
    "digest": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "completionSummaryMarkdown": { "type": "string" },
    "markdown": { "type": "string" },
    "findingSummary": {
      "type": "object",
      "required": ["total", "bySeverity"],
      "properties": {
        "total": { "type": "number" },
        "bySeverity": { "type": "object", "additionalProperties": { "type": "number" } }
      },
      "additionalProperties": true
    },
    "renderedFindingIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "renderedNeedsHumanIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expectedFindingCount": { "type": "number" },
    "expectedMergedFindingCount": { "type": "number" },
    "mergedFindingCount": { "type": "number" },
    "needsHumanSummary": {
      "type": "object",
      "required": ["actual", "expected", "metadataMissing", "incompleteEvidence"],
      "properties": {
        "actual": { "type": "number" },
        "expected": { "type": "number" },
        "metadataMissing": { "type": "boolean" },
        "incompleteEvidence": { "type": "number" }
      },
      "additionalProperties": false
    },
    "supportNoteSummary": {
      "type": "object",
      "required": ["actual", "expected", "metadataMissing", "incompleteEvidence"],
      "properties": {
        "actual": { "type": "number" },
        "expected": { "type": "number" },
        "metadataMissing": { "type": "boolean" },
        "incompleteEvidence": { "type": "number" }
      },
      "additionalProperties": false
    },
    "sourceArtifacts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gates": {
      "type": "object",
      "required": [
        "renderedAllFindings",
        "renderedAllNeedsHuman",
        "renderedAllSupportNotes",
        "findingCountMismatch",
        "needsHumanCountMismatch",
        "needsHumanMetadataMissing",
        "needsHumanEvidenceIncomplete",
        "reportSynthesisAvailable",
        "reportVerdictConsistent",
        "supportNoteCountMismatch",
        "supportNoteMetadataMissing",
        "supportNoteEvidenceIncomplete",
        "passed"
      ],
      "properties": {
        "renderedAllFindings": { "type": "boolean" },
        "renderedAllNeedsHuman": { "type": "boolean" },
        "renderedAllSupportNotes": { "type": "boolean" },
        "findingCountMismatch": { "type": "boolean" },
        "ledgerTopLevelCountMismatch": { "type": "boolean" },
        "uniqueLedgerIds": { "type": "boolean" },
        "duplicateLedgerIds": { "type": "array", "items": { "type": "string" } },
        "mergedFindingCountMismatch": { "type": "boolean" },
        "renderedAllLineage": { "type": "boolean" },
        "renderedAllDropped": { "type": "boolean" },
        "needsHumanCountMismatch": { "type": "boolean" },
        "needsHumanMetadataMissing": { "type": "boolean" },
        "needsHumanEvidenceIncomplete": { "type": "boolean" },
        "reportSynthesisAvailable": { "type": "boolean" },
        "reportVerdictConsistent": { "type": "boolean" },
        "supportNoteCountMismatch": { "type": "boolean" },
        "supportNoteMetadataMissing": { "type": "boolean" },
        "supportNoteEvidenceIncomplete": { "type": "boolean" },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "sidecarPath": { "type": "string", "const": "final-report.md" }
  },
  "additionalProperties": true
}
