{
  "type": "object",
  "required": [
    "schema",
    "digest",
    "summary",
    "verdict",
    "risks",
    "recommendedNextAction"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "stage-control-v1"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "verdict": {
      "type": "string",
      "enum": ["REVIEW_COMPLETE", "NEEDS_WORK", "PARTIAL_REVIEW"]
    },
    "risks": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "recommendedNextAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "additionalProperties": false
}
