{
  "type": "object",
  "required": ["schema", "digest", "findingId", "finding", "verdict", "evidence", "counterEvidence", "recommendedAction"],
  "properties": {
    "schema": { "type": "string", "const": "stage-control-v1" },
    "digest": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "findingId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "finding": { "type": "string", "minLength": 1, "maxLength": 400 },
    "verdict": { "type": "string", "enum": ["KEEP", "WEAKEN", "DROP", "NEEDS_HUMAN"] },
    "evidence": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "counterEvidence": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "recommendedAction": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "additionalProperties": false
}
