{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "digest",
    "id",
    "path",
    "documentStatus",
    "questions",
    "limitations"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "fixed-item-v1"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "documentStatus": {
      "type": "string",
      "enum": [
        "read",
        "partial",
        "unreadable"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
